tab_overall_hetero <- df_desc_hetero %>%
summarise(
N_obs         = n(),
N_ads         = n_distinct(anuncio_id),
share_control = mean(treatment == "control"),
share_eu      = mean(treatment == "eu"),
share_non_eu  = mean(treatment == "non_eu"),
share_native_landlord  = mean(landlord_type == "native"),
share_foreign_landlord = mean(landlord_type == "foreign"),
mean_Y        = mean(Y),
sd_Y          = sd(Y)
)
tab_overall_hetero
# Tabla 4: descriptivas por tratamiento y tipo de landlord (heterogeneidad)
tab_by_treat_landlord <- df_desc_hetero %>%
group_by(landlord_type, treatment) %>%
summarise(
N_obs  = n(),
mean_Y = mean(Y),
sd_Y   = sd(Y)
) %>%
arrange(landlord_type, treatment)
tab_by_treat_landlord
df_robust_main <- df_desc_main %>%
mutate(
d_eu   = as.numeric(treatment == "eu"),
d_non  = as.numeric(treatment == "non_eu"),
city_f = factor(city),
landlord_type_f = factor(landlord_type)
)
# Chequeo rápido
table(df_robust_main$treatment)
head(df_robust_main)
# Modelo 1: LPM básico (es tu especificación principal)
mod1_lpm <- lm(Y ~ d_eu + d_non, data = df_robust_main)
mod1_cs  <- coef_test(mod1_lpm, cluster = df_robust_main$anuncio_id, vcov = "CR2")
cat("\n=== Modelo 1: LPM básico (Y ~ d_eu + d_non), SE cluster por anuncio ===\n")
print(mod1_cs)
# Modelo 2: LPM + controles (ciudad y tipo de landlord)
mod2_lpm <- lm(Y ~ d_eu + d_non + city_f + landlord_type_f, data = df_robust_main)
mod2_cs  <- coef_test(mod2_lpm, cluster = df_robust_main$anuncio_id, vcov = "CR2")
cat("\n=== Modelo 2: LPM + FE de ciudad y tipo de landlord ===\n")
print(mod2_cs)
# Modelo 3: Logit simple sin controles
mod3_logit <- glm(
Y ~ d_eu + d_non,
data   = df_robust_main,
family = binomial(link = "logit")
)
mod3_cs <- coef_test(mod3_logit, cluster = df_robust_main$anuncio_id, vcov = "CR2")
cat("\n=== Modelo 3: Logit (Y ~ d_eu + d_non), SE cluster por anuncio ===\n")
print(mod3_cs)
# Modelo 4: Logit + controles (ciudad y tipo de landlord)
mod4_logit <- glm(
Y ~ d_eu + d_non + city_f + landlord_type_f,
data   = df_robust_main,
family = binomial(link = "logit")
)
mod4_cs <- coef_test(mod4_logit, cluster = df_robust_main$anuncio_id, vcov = "CR2")
cat("\n=== Modelo 4: Logit + FE de ciudad y tipo de landlord ===\n")
print(mod4_cs)
## (Opcional) Modelo 5: Probit simple
mod5_probit <- glm(
Y ~ d_eu + d_non,
data   = df_robust_main,
family = binomial(link = "probit")
)
mod5_cs <- coef_test(mod5_probit, cluster = df_robust_main$anuncio_id, vcov = "CR2")
cat("\n=== Modelo 5: Probit (Y ~ d_eu + d_non), SE cluster por anuncio ===\n")
print(mod5_cs)
## (Opcional) Modelo 6: Probit + controles
mod6_probit <- glm(
Y ~ d_eu + d_non + city_f + landlord_type_f,
data   = df_robust_main,
family = binomial(link = "probit")
)
mod6_cs <- coef_test(mod6_probit, cluster = df_robust_main$anuncio_id, vcov = "CR2")
cat("\n=== Modelo 6: Probit + FE de ciudad y tipo de landlord ===\n")
print(mod6_cs)
extract_d_non <- function(cs_object, model_name) {
df_cs <- as.data.frame(cs_object)
# Buscamos la fila 'd_non' (puede ajustar si cambia el nombre)
idx <- which(rownames(df_cs) == "d_non")
if (length(idx) == 0) return(NULL)
tibble(
modelo    = model_name,
estimate  = df_cs[idx, grep("coef|Estimate|beta", colnames(df_cs), ignore.case = TRUE)][[1]],
se        = df_cs[idx, grep("SE|Std\\.Error|std_error", colnames(df_cs), ignore.case = TRUE)][[1]],
p_value   = df_cs[idx, grep("^p$|p_Satt|p.value|p_val", colnames(df_cs), ignore.case = TRUE)][[1]]
)
}
robust_table_main <- bind_rows(
extract_d_non(mod1_cs, "LPM básico"),
extract_d_non(mod2_cs, "LPM + FE ciudad/landlord"),
extract_d_non(mod3_cs, "Logit"),
extract_d_non(mod4_cs, "Logit + FE ciudad/landlord"),
extract_d_non(mod5_cs, "Probit"),
extract_d_non(mod6_cs, "Probit + FE ciudad/landlord")
)
cat("\n=== Resumen de robustez para el efecto non_eu (d_non) ===\n")
print(robust_table_main)
df_robust_hetero <- df_desc_hetero %>%
mutate(
d_eu   = as.numeric(treatment == "eu"),
d_non  = as.numeric(treatment == "non_eu"),
city_f = factor(city),
landlord_type_f = factor(landlord_type),
landlord_foreign = as.numeric(landlord_type == "foreign")
)
# Modelo 7: LPM con interacción non_eu * landlord_foreign
mod7_lpm_int <- lm(Y ~ d_eu + d_non * landlord_foreign + city_f + landlord_type_f,
data = df_robust_hetero)
mod7_cs <- coef_test(mod7_lpm_int, cluster = df_robust_hetero$anuncio_id, vcov = "CR2")
cat("\n=== Modelo 7: LPM con interacción d_non * landlord_foreign ===\n")
print(mod7_cs)
# Modelo 8: Logit con interacción
mod8_logit_int <- glm(
Y ~ d_eu + d_non * landlord_foreign + city_f + landlord_type_f,
data   = df_robust_hetero,
family = binomial(link = "logit")
)
mod8_cs <- coef_test(mod8_logit_int, cluster = df_robust_hetero$anuncio_id, vcov = "CR2")
cat("\n=== Modelo 8: Logit con interacción d_non * landlord_foreign ===\n")
print(mod8_cs)
